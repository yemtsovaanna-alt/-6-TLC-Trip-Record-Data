            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00B2A9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Juno"
            },
            "properties": [
              {
                "id": "color",
                "value": {
