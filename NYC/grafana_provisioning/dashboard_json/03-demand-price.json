          "yHistogram": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "m"
        }
      },
      "timeFrom": "now/d"
    },
    {
      "id": 12,
      "title": "У кого из агрегаторов дольше медианное ожидание?",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "nyc_taxi_pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "nyc_taxi_pg"
          },
          "rawSql": "SELECT 'ожидание' AS metric, round((sum(med_wait_sec * n_trips) FILTER (WHERE aggregator='Uber')/nullif(sum(n_trips) FILTER (WHERE aggregator='Uber'),0)/60.0)::numeric,2) AS \"Uber\", round((sum(med_wait_sec * n_trips) FILTER (WHERE aggregator='Lyft')/nullif(sum(n_trips) FILTER (WHERE aggregator='Lyft'),0)/60.0)::numeric,2) AS \"Lyft\", round((sum(med_wait_sec * n_trips) FILTER (WHERE aggregator='Via')/nullif(sum(n_trips) FILTER (WHERE aggregator='Via'),0)/60.0)::numeric,2) AS \"Via\", round((sum(med_wait_sec * n_trips) FILTER (WHERE aggregator='Juno')/nullif(sum(n_trips) FILTER (WHERE aggregator='Juno'),0)/60.0)::numeric,2) AS \"Juno\" FROM zone_wait_by_aggregator WHERE aggregator IN (${aggregator:sqlstring}) AND n_trips >= 50",
          "rawQuery": true,
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uber"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#06C167"
                }
              }
            ]
          },
