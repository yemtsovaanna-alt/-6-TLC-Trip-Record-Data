    {
      "id": 10,
      "title": "В какие часы и дни недели дольше ждать? (мин, фильтр агрегатора)",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "type": "heatmap",
      "datasource": {
        "type": "postgres",
        "uid": "nyc_taxi_pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "nyc_taxi_pg"
          },
          "rawSql": "\nSELECT\n  (date_trunc('day', $__timeTo()::timestamptz) + hour * INTERVAL '1 hour') AS \"time\",\n  round((sum(med_wait_sec * n_trips) FILTER (WHERE dow=0) / nullif(sum(n_trips) FILTER (WHERE dow=0), 0) / 60.0)::numeric, 2) AS \"Пн\",\n  round((sum(med_wait_sec * n_trips) FILTER (WHERE dow=1) / nullif(sum(n_trips) FILTER (WHERE dow=1), 0) / 60.0)::numeric, 2) AS \"Вт\",\n  round((sum(med_wait_sec * n_trips) FILTER (WHERE dow=2) / nullif(sum(n_trips) FILTER (WHERE dow=2), 0) / 60.0)::numeric, 2) AS \"Ср\",\n  round((sum(med_wait_sec * n_trips) FILTER (WHERE dow=3) / nullif(sum(n_trips) FILTER (WHERE dow=3), 0) / 60.0)::numeric, 2) AS \"Чт\",\n  round((sum(med_wait_sec * n_trips) FILTER (WHERE dow=4) / nullif(sum(n_trips) FILTER (WHERE dow=4), 0) / 60.0)::numeric, 2) AS \"Пт\",\n  round((sum(med_wait_sec * n_trips) FILTER (WHERE dow=5) / nullif(sum(n_trips) FILTER (WHERE dow=5), 0) / 60.0)::numeric, 2) AS \"Сб\",\n  round((sum(med_wait_sec * n_trips) FILTER (WHERE dow=6) / nullif(sum(n_trips) FILTER (WHERE dow=6), 0) / 60.0)::numeric, 2) AS \"Вс\"\nFROM wait_by_hour_dow_aggregator\nWHERE aggregator IN (${aggregator:sqlstring})\nGROUP BY hour\nORDER BY hour\n",
          "rawQuery": true,
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 2,
        "color": {
          "mode": "scheme",
          "scheme": "RdYlBu",
          "reverse": true,
          "scale": "linear",
          "steps": 64,
          "fill": "#F98513"
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
