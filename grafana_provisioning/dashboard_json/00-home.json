      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "nyc_taxi_pg"
          },
          "rawSql": "WITH yr AS (\n  SELECT extract(year FROM month)::int AS yr, aggregator, sum(trips) AS trips\n  FROM aggregator_monthly GROUP BY 1, 2\n),\ntot AS (SELECT yr, sum(trips) AS total FROM yr GROUP BY 1)\nSELECT make_date(y.yr, 1, 1) AS time, round(100.0 * y.trips / t.total, 1) AS uber_share\nFROM yr y JOIN tot t ON t.yr = y.yr\nWHERE y.aggregator = 'Uber' ORDER BY y.yr",
          "rawQuery": true,
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
