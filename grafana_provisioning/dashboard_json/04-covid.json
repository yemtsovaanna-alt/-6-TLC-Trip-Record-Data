        {
          "datasource": {
            "type": "postgres",
            "uid": "nyc_taxi_pg"
          },
          "rawSql": "SELECT taxi_type, min(index_jan2019_100) AS min_index_pct, (array_agg(month ORDER BY index_jan2019_100 ASC))[1] AS bottom_month FROM monthly_by_type_indexed WHERE month < '2021-01-01' AND taxi_type IN (${taxi_type:sqlstring}) GROUP BY taxi_type ORDER BY min_index_pct",
          "rawQuery": true,
          "format": "table",
