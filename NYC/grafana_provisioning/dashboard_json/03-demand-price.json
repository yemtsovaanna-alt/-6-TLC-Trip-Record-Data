    {
      "id": 11,
      "title": "В каких зонах покрытия хуже всего с подачей? (топ-15, мин)",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 14,
        "h": 10
      },
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "nyc_taxi_pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "nyc_taxi_pg"
          },
          "rawSql": "SELECT sa.zone_name, round((sum(zwa.med_wait_sec * zwa.n_trips)/nullif(sum(zwa.n_trips),0)/60.0)::numeric,2) AS med_wait_min FROM zone_wait_by_aggregator zwa JOIN subway_access sa ON sa.\"LocationID\" = zwa.zone JOIN zone_dominant_type zdt ON zdt.zone = zwa.zone WHERE zwa.aggregator IN (${aggregator:sqlstring}) AND zwa.n_trips >= 50 AND sa.borough IN (${borough:sqlstring}) AND zdt.dominant_type IN (${taxi_type:sqlstring}) GROUP BY sa.zone_name ORDER BY med_wait_min DESC NULLS LAST LIMIT 15",
          "rawQuery": true,
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#F98513"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xTickLabelRotation": 0
      }
    },
